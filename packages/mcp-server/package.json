{
  "name": "@taopp/mcp-server",
  "version": "0.1.1",
  "description": "MCP server for TAOP Agent Credit Bureau + LoRA Guilds. Exposes on-chain tools for AI agents (get scores, discover capabilities, attest, challenge, register, etc.).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "taop-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@taopp/sdk": "^0.1.1",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
