{
  "name": "taop-credit-bureau",
  "private": true,
  "version": "0.0.0",
  "description": "TAOP MVP \u2014 Agent Credit Bureau + LoRA Guilds (vertical demo slice)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "contracts:build": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:test:gas": "REPORT_GAS=true hardhat test",
    "contracts:test:foundry": "forge test -vv",
    "contracts:coverage": "SKIP_SIZE_CHECK=true hardhat coverage",
    "slither": "slither . --config-file slither.config.json --fail-medium",
    "lint": "eslint .",
    "lint:sol": "solhint 'contracts/**/*.sol' --max-warnings 0",
    "mutation:spotcheck": "node scripts/mutation-spotcheck.mjs",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy-base-sepolia.ts --network base",
    "sdk:build": "npm run build -w @taopp/sdk",
    "mcp:build": "npm run build -w @taopp/mcp-server",
    "mcp:dev": "npm run dev -w @taopp/mcp-server",
    "mcp:publish": "npm publish -w @taopp/mcp-server --access public",
    "backend:dev": "tsx watch packages/backend/src/server.ts",
    "backend:test": "vitest run packages/backend/test",
    "mcp:test": "vitest run packages/mcp-server/test",
    "backend:build": "esbuild packages/backend/src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=packages/backend/dist/server.cjs",
    "demo:dev": "vite --config apps/demo/vite.config.ts",
    "demo:build": "vite build --config apps/demo/vite.config.ts",
    "demo:static:dev": "vite --config apps/static-demo/vite.config.ts",
    "demo:static:build": "vite build --config apps/static-demo/vite.config.ts",
    "typecheck": "npm run typecheck -ws --if-present && tsc -p packages/backend --noEmit && tsc -p packages/mcp-server --noEmit",
    "test": "hardhat test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "docs:api": "typedoc",
    "e2e:local": "bash scripts/e2e-local.sh",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "coverage:check": "node scripts/check-coverage.mjs",
    "rehearse:mainnet-fork": "REHEARSAL=true FORK_BASE_MAINNET=true DEPLOYMENTS_PATH=/tmp/taop-fork-rehearsal.json hardhat run scripts/deploy-base-sepolia.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "swagger-ui-dist": "^5.32.15"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@tailwindcss/vite": "^4.3.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solhint": "^6.2.4",
    "solidity-coverage": "^0.8.17",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typechain": "^8.3.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.1",
    "lodash": "4.17.15"
  }
}
