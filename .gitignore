# Dependencies
node_modules/

# Build outputs
dist/
artifacts/
cache/
typechain-types/

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Hardhat
deployments.json
# Keep example
!deployments.json.example

# SDK tsc build artifacts inside src (generated)
packages/sdk/src/*.js
packages/sdk/src/*.js.map
packages/sdk/src/*.d.ts
packages/sdk/src/*.d.ts.map

# SQLite local cache (runtime state, never source)
taop.db
taop.db-shm
taop.db-wal
*.db
*.db-shm
*.db-wal

# Python cache + build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
*.whl

# Misc
*.tgz
coverage/