# TAOP Pilot — copy to .env and fill in
# Public RPC (recommended for quick testing, no key needed):
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
#
# Or use your own (Infura, Alchemy, etc.):
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/<YOUR_INFURA_KEY>

# Mainnet prep (Step 5): keep delay=0 for pilot. Set this + funded wallet for `npm run deploy:mainnet`
# BASE_MAINNET_RPC_URL=https://mainnet.base.org

# For hardened/mainnet deploys: use a multisig (recommended) or custom lists.
# MULTISIG_ADDRESS=0xYourSafeAddress   # If set, used for both proposers and executors
# Or:
# PROPOSERS=0xAddr1,0xAddr2
# EXECUTORS=0xAddr1,0xAddr2
# TIMELOCK_DELAY=86400   # 24h for hardened (0 for pilot)

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PK=0x<YOUR_DEPLOYER_PRIVATE_KEY>
PINATA_API_KEY=<YOUR_PINATA_API_KEY>
PINATA_JWT=<YOUR_PINATA_JWT>
REPLICATE_API_TOKEN=<YOUR_REPLICATE_TOKEN>
