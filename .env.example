# TAOP Pilot — copy to .env and fill in  (NEVER commit .env)
#
# SECRETS POLICY (Phase 0): all key material lives here or in your host's env.
# `deployments.json` is a publishable artifact and must contain ADDRESSES ONLY —
# see SECURITY.md. Do not paste private keys into issues, chats, or logs.

# --- RPC ---
# Public RPC (no key needed, good default):
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Or your own: https://base-sepolia.infura.io/v3/<YOUR_INFURA_KEY>
# Local hardhat node (needed for the local quickstart so the backend targets 31337):
# RPC_URL=http://127.0.0.1:8545
# Mainnet prep: set this + a funded wallet for `npm run deploy:mainnet`
# BASE_MAINNET_RPC_URL=https://mainnet.base.org

# --- Wallets / keys ---
DEPLOYER_PK=0x<YOUR_DEPLOYER_PRIVATE_KEY>
# Generated automatically by `npm run deploy:sepolia` (written to .env, chmod 600)
# AGENT_A_PK=0x<DEMO_AGENT_PRIVATE_KEY>

# --- Backend server safety (Phase 0 hardening) ---
# Bind address. Loopback is the safe default; a non-loopback HOST requires TAOP_API_KEY.
HOST=127.0.0.1
PORT=4000
# Serve a public demo with writes disabled (safe read-only instance):
# DEMO_READ_ONLY=true
# Require `X-TAOP-Key` on every non-GET /api route (REQUIRED if HOST is public).
# Generate with: openssl rand -hex 32
# TAOP_API_KEY=
# If the backend sits behind a reverse proxy / tunnel, set its hop count:
# TRUST_PROXY=1
# Restrict browser origins instead of allowing all:
# CORS_ORIGIN=https://demo.example.com

# --- Demo UI (build-time) ---
# Must match TAOP_API_KEY so the UI can perform write actions:
# VITE_TAOP_API_KEY=

# --- Discovery indexer (F10, optional) ---
# The backend indexes logs into SQLite and serves /api/discover from it.
# Disable with INDEXER_ENABLED=false (falls back to direct on-chain scanning).
# INDEXER_ENABLED=true
# INDEXER_POLL_MS=15000          # poll interval
# INDEXER_CHUNK_SIZE=2000        # getLogs range per call (public RPCs cap ~10k)
# INDEXER_CONFIRMATIONS=5        # only index up to head-N (shallow-reorg safety)
# INDEXER_MAX_CHUNKS_PER_TICK=20
# INDEXER_START_BLOCK=0          # explicit start; else deployments.json deployedBlock, else lookback
# INDEXER_LOOKBACK_BLOCKS=50000  # used when no start block is known

# --- Signed outbound webhooks (optional; disabled unless URL is set) ---
# Alerts are POSTed in order, at-least-once; de-duplicate on x-taop-delivery.
# TAOP_WEBHOOK_URL=https://example.com/hooks/taop
# TAOP_WEBHOOK_SECRET=<random 64-char hex>
# TAOP_WEBHOOK_POLL_MS=5000
# TAOP_WEBHOOK_TIMEOUT_MS=10000
# TAOP_WEBHOOK_MAX_PER_POLL=25


# --- IPFS / inference credentials ---
PINATA_API_KEY=<YOUR_PINATA_API_KEY>
PINATA_JWT=<YOUR_PINATA_JWT>
REPLICATE_API_TOKEN=<YOUR_REPLICATE_TOKEN>

# --- Deploy hardening (optional) ---
# MULTISIG_ADDRESS=0xYourSafeAddress   # used for both proposers and executors
# PROPOSERS=0xAddr1,0xAddr2
# EXECUTORS=0xAddr1,0xAddr2
# TIMELOCK_DELAY=86400   # 24h for hardened (0 for pilot)
